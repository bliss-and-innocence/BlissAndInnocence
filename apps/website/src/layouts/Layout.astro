<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/B&I-logo.jpg" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="rgb(250, 227, 221)" />
		<script>
			(() => {
				try {
					const hasSeenLoader = window.sessionStorage.getItem('bi-loader-hidden') === 'true';
					document.documentElement.classList.toggle('loader-hidden', hasSeenLoader);
					if (!hasSeenLoader) {
						window.sessionStorage.setItem('bi-loader-hidden', 'true');
					}
				} catch (error) {
					document.documentElement.classList.remove('loader-hidden');
				}
			})();
		</script>
		<title>Bliss &amp; Innocence</title>
	</head>
	<body>
		<div id="page-loader" aria-live="polite" aria-busy="true">
			<img src="/B&I-logo.jpg" alt="Bliss &amp; Innocence logo" class="loader-logo" />
		</div>

		<header class="site-header">
			<nav class="site-nav" aria-label="Main navigation">
				<a href="/" class="brand" aria-label="Bliss and Innocence home">
					<img src="/B&I-logo.jpg" alt="Bliss &amp; Innocence logo" class="brand-logo" />
				</a>
				<div class="nav-links">
					<a href="/">Releases</a>
					<a href="/core">Team</a>
					<a href="/contributors">Contributors</a>
					<a href="/blog">Blog</a>
					<a href="#" class="nav-submissions" data-submissions-url="https://forms.gle/vkFagNFxKEPcJgko8">Submissions</a>
				</div>
			</nav>
		</header>

		<div class="page-content">
			<slot />
		</div>

		<div id="submission-toast" class="submission-toast" role="status" aria-live="polite">
			No submissions are currently open!
		</div>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<img src="/B&I-logo.jpg" alt="Bliss &amp; Innocence logo" class="footer-logo" />
				</div>

				<nav class="footer-nav" aria-label="Footer navigation">
					<a href="/">Releases</a>
					<a href="/core">Team</a>
					<a href="/contributors">Contributors</a>
					<a href="/blog">Blog</a>
				</nav>

				<div class="footer-socials" aria-label="Social media links">
					<a href="https://blissandinnocence.bandcamp.com/" target="_blank" rel="noreferrer" aria-label="Bandcamp">
						<img src="/social%20media/bandcamp-button-circle-line-green-256.png" alt="Bandcamp" />
					</a>
					<a href="https://discord.gg/MGF6M3keNg" target="_blank" rel="noreferrer" aria-label="Discord">
						<img src="/social%20media/discord-round-color-icon.svg" alt="Discord" />
					</a>
					<a href="https://x.com/blissandI" target="_blank" rel="noreferrer" aria-label="X">
						<img src="/social%20media/x-social-media-logo-icon.svg" alt="X" />
					</a>
				</div>
			</div>
		</footer>

		<script>
			const loader = document.getElementById('page-loader');
			const submissionsLink = document.querySelector('.nav-submissions');
			const submissionToast = document.getElementById('submission-toast');
			let warningTimer: number | undefined;
			let hideTimer: number | undefined;

			const hideLoader = () => {
				if (!loader) {
					return;
				}

				loader.classList.add('is-hidden');
				document.documentElement.classList.add('loader-hidden');
			};

			if (loader && !document.documentElement.classList.contains('loader-hidden')) {
				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const delay = reducedMotion ? 500 : 2600;
				const fallbackDelay = reducedMotion ? 1200 : 4200;

				if (document.readyState === 'complete') {
					window.setTimeout(hideLoader, delay);
				} else {
					window.addEventListener('load', () => {
						window.setTimeout(hideLoader, delay);
					}, { once: true });
				}

				window.setTimeout(hideLoader, fallbackDelay);
			}

			if (submissionsLink && submissionToast) {
				const applySubmissionUrl = () => {
					const url = submissionsLink.getAttribute('data-submissions-url');
					if (url && url.trim()) {
						submissionsLink.setAttribute('href', url);
						submissionsLink.setAttribute('target', '_blank');
						submissionsLink.setAttribute('rel', 'noopener noreferrer');
						return true;
					}

					submissionsLink.setAttribute('href', '#');
					submissionsLink.removeAttribute('target');
					submissionsLink.removeAttribute('rel');
					return false;
				};

				applySubmissionUrl();

				submissionsLink.addEventListener('click', (event) => {
					if (!applySubmissionUrl()) {
						event.preventDefault();
						submissionToast.classList.remove('is-warning');
						void submissionToast.offsetWidth;
						submissionToast.classList.add('is-visible', 'is-warning');
						window.clearTimeout(warningTimer);
						window.clearTimeout(hideTimer);
						warningTimer = window.setTimeout(() => {
							submissionToast.classList.remove('is-warning');
						}, 150);
						hideTimer = window.setTimeout(() => {
							submissionToast.classList.remove('is-visible', 'is-warning');
						}, 2200);
					}
				});
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-family: Arial, sans-serif;
		background: rgb(250 227 221);
		color: #111111;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	* {
		box-sizing: border-box;
	}

	.page-content {
		flex: 1;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(250, 227, 221, 0.9);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(17, 17, 17, 0.08);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		padding: 16px 24px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.brand-logo {
		display: block;
		height: 92px;
		width: auto;
		object-fit: contain;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.nav-links a {
		color: #111111;
		text-decoration: none;
		font-size: 0.95rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.nav-submissions {
		cursor: pointer;
	}

	.submission-toast {
		position: fixed;
		right: 20px;
		bottom: 20px;
		padding: 10px 14px;
		background: rgba(17, 17, 17, 0.96);
		color: #ffffff;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		border: 1px solid rgba(255, 255, 255, 0.12);
		opacity: 0;
		visibility: hidden;
		transform: translateX(140%) translateY(8px);
		transition: opacity 0.24s ease, transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.24s ease, background-color 0.18s ease, border-color 0.18s ease;
		z-index: 1000;
	}

	.submission-toast.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateX(0) translateY(0);
	}

	.submission-toast.is-warning {
		background: rgba(182, 52, 52, 0.98);
		border-color: rgba(255, 203, 203, 0.7);
		animation: toast-shake 0.22s ease-in-out 2;
	}

	@keyframes toast-shake {
		0%, 100% {
			transform: translateX(0) translateY(0);
		}
		25% {
			transform: translateX(0) translateY(-4px);
		}
		50% {
			transform: translateX(0) translateY(4px);
		}
		75% {
			transform: translateX(0) translateY(-2px);
		}
	}

	.site-footer {
		background: #000000;
		color: #ffffff;
		padding: 28px 24px 32px;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	.footer-brand {
		display: flex;
		align-items: center;
	}

	.footer-logo {
		display: block;
		height: 84px;
		width: auto;
		object-fit: contain;
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}

	.footer-nav a {
		color: #ffffff;
		text-decoration: none;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-socials {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 12px;
	}

	.footer-socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		text-decoration: none;
	}

	.footer-socials img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter: grayscale(1) contrast(1.15) brightness(1.1);
		opacity: 0.95;
	}

	#page-loader {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgb(250 227 221);
		z-index: 9999;
		opacity: 1;
		visibility: visible;
		transition: opacity 0.8s ease, visibility 0.8s ease;
	}

	html.loader-hidden #page-loader,
	#page-loader.is-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.loader-logo {
		display: block;
		width: auto;
		height: auto;
		max-width: min(42vw, 240px);
		max-height: 40vh;
		object-fit: contain;
		transform: scale(0.9);
		animation: logoZoom 2.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	@keyframes logoZoom {
		0% {
			opacity: 0;
			transform: scale(1.3);
		}
		18% {
			opacity: 1;
		}
		68% {
			opacity: 1;
			transform: scale(1.5);
		}
		100% {
			opacity: 0;
			transform: scale(1.7);
		}
	}
</style>
