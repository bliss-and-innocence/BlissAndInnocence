---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
}

const {
	title = 'Bliss & Innocence',
	description = 'Bliss & Innocence — music, releases, artists, and more.',
	image = '/B&I-logo.jpg',
	url = '/',
} = Astro.props;

const siteUrl = 'https://blissandinnocence.art';

const absoluteImageUrl = image.startsWith('http')
	? image
	: `${siteUrl}${image}`;

const absolutePageUrl = url.startsWith('http')
	? url
	: `${siteUrl}${url}`;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/B&I-logo.jpg" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="rgb(250, 227, 221)" />

		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Bliss & Innocence" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={absolutePageUrl} />
		<meta property="og:image" content={absoluteImageUrl} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageUrl} />

		<script>
			(() => {
				try {
					const hasSeenLoader = window.sessionStorage.getItem('bi-loader-hidden') === 'true';
					document.documentElement.classList.toggle('loader-hidden', hasSeenLoader);
					if (!hasSeenLoader) {
						window.sessionStorage.setItem('bi-loader-hidden', 'true');
					}
				} catch (error) {
					document.documentElement.classList.remove('loader-hidden');
				}
			})();
		</script>

		<title>{title}</title>
	</head>
	<body>
		<div id="page-loader" aria-live="polite" aria-busy="true">
			<img src="/B&I-logo.jpg" alt="Bliss &amp; Innocence logo" class="loader-logo" />
		</div>

		<header class="site-header">
			<nav class="site-nav" aria-label="Main navigation">
				<a href="/" class="brand" aria-label="Bliss and Innocence home">
					<img src="/B&I-logo.jpg" alt="Bliss &amp; Innocence logo" class="brand-logo" />
				</a>
				<div class="nav-links">
					<a href="/">Releases</a>
					<a href="/core">Team</a>
					<a href="/contributors">Contributors</a>
					<a href="/blog">Blog</a>
					<a href="/submissions">Submissions</a>
				</div>
			</nav>
		</header>

		<div class="page-content">
			<slot />
		</div>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<img src="/B&I-logo.jpg" alt="Bliss &amp; Innocence logo" class="footer-logo" />
				</div>

				<nav class="footer-nav" aria-label="Footer navigation">
					<a href="/">Releases</a>
					<a href="/core">Team</a>
					<a href="/contributors">Contributors</a>
					<a href="/blog">Blog</a>
				</nav>

				<div class="footer-socials" aria-label="Social media links">
					<a href="https://blissandinnocence.bandcamp.com/" target="_blank" rel="noreferrer" aria-label="Bandcamp">
						<img src="/social%20media/bandcamp.webp" alt="Bandcamp" />
					</a>
					<a href="https://discord.gg/MGF6M3keNg" target="_blank" rel="noreferrer" aria-label="Discord">
						<img src="/social%20media/discord.svg" alt="Discord" />
					</a>
					<a href="https://x.com/blissandI" target="_blank" rel="noreferrer" aria-label="X">
						<img src="/social%20media/x.svg" alt="X" />
					</a>
					<a href="https://www.youtube.com/@blissandinnocence2827" target="_blank" rel="noreferrer" aria-label="YouTube">
						<img src="/social%20media/youtube.svg" alt="YouTube" />
					</a>
				</div>
			</div>
		</footer>

		<script>
			const loader = document.getElementById('page-loader');

			const hideLoader = () => {
				if (!loader) return;
				loader.classList.add('is-hidden');
				document.documentElement.classList.add('loader-hidden');
			};

			if (loader && !document.documentElement.classList.contains('loader-hidden')) {
				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const delay = reducedMotion ? 500 : 2600;
				const fallbackDelay = reducedMotion ? 1200 : 4200;

				if (document.readyState === 'complete') {
					window.setTimeout(hideLoader, delay);
				} else {
					window.addEventListener('load', () => {
						window.setTimeout(hideLoader, delay);
					}, { once: true });
				}

				window.setTimeout(hideLoader, fallbackDelay);
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		max-width: 100%;
		overflow-x: hidden;
	}

	body {
		font-family: "Times New Roman", Arial, sans-serif;
		background: rgb(250 227 221);
		color: #111111;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	* {
		box-sizing: border-box;
	}

	.page-content {
		flex: 1;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(250, 227, 221, 0.9);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(17, 17, 17, 0.08);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		padding: 16px 32px;
		gap: 32px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.brand-logo {
		display: block;
		height: 92px;
		width: auto;
		object-fit: contain;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 28px;
	}

	.nav-links a {
		position: relative;
		color: #111111;
		text-decoration: none;
		font-size: 0.95rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: opacity 0.2s ease;
	}

	.nav-links a::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -6px;
		width: 100%;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.25s ease;
	}

	.nav-links a:hover {
		opacity: 0.65;
	}

	.nav-links a:hover::after {
		transform: scaleX(1);
	}

	@media (max-width: 760px) {
		.site-nav {
			flex-direction: column;
			align-items: center;
			padding-top: 14px;
			padding-bottom: 14px;
		}

		.brand-logo {
			height: 72px;
		}

		.nav-links {
			justify-content: center;
			gap: 12px 16px;
		}

		.nav-links a {
			font-size: 0.72rem;
		}
	}

	.nav-submissions {
		cursor: pointer;
	}

	.site-footer {
		background: #000000;
		color: #ffffff;
		padding: 28px 24px 32px;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	.footer-brand {
		display: flex;
		align-items: center;
	}

	.footer-logo {
		display: block;
		height: 84px;
		width: auto;
		object-fit: contain;
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}

	.footer-nav a {
		color: #ffffff;
		text-decoration: none;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-socials {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 12px;
	}

	.footer-socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		text-decoration: none;
	}

	.footer-socials img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;

		filter: grayscale(1) contrast(1.15) brightness(1.1);
		opacity: 0.55;

		transition:
			filter 0.25s ease,
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.footer-socials a:hover img {
		filter: grayscale(0) contrast(1) brightness(1);
		opacity: 1;
		transform: translateY(-3px) scale(1.08);
	}

	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.footer-brand,
		.footer-nav,
		.footer-socials {
			justify-self: center;
		}

		.footer-nav {
			align-items: center;
		}
	}

	#page-loader {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgb(250 227 221);
		z-index: 9999;
		opacity: 1;
		visibility: visible;
		transition: opacity 0.8s ease, visibility 0.8s ease;
	}

	html.loader-hidden #page-loader,
	#page-loader.is-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.loader-logo {
		display: block;
		width: auto;
		height: auto;
		max-width: min(42vw, 240px);
		max-height: 40vh;
		object-fit: contain;
		transform: scale(0.9);
		animation: logoZoom 2.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	@keyframes logoZoom {
		0% {
			opacity: 0;
			transform: scale(1.3);
		}
		18% {
			opacity: 1;
		}
		68% {
			opacity: 1;
			transform: scale(1.5);
		}
		100% {
			opacity: 0;
			transform: scale(1.7);
		}
	}
</style>
