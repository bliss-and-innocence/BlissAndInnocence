---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, parseInlineMarkdown } from '../../data/blog';

const posts = [...blogPosts].sort(
    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<Layout
  title="Blog — Bliss and Innocence"
  description="News and updates from Bliss and Innocence releases, artists, submissions, and label announcements."
  image="/B&I-logo.jpg"
  url="/blog/"
>
  <main class="blog-page">
    <div class="blog-content">

      <h1>
        <span class="title-decoration">//// </span>
        Blog
        <span class="title-decoration"> ////</span>
      </h1>

      <div class="blog-list">
        {posts.map((post) => (
            <article class="blog-post">

              <div class="blog-post-content">

                <div class="blog-meta">
                  <span class="blog-date">{post.date}</span>

                  {post.announcer ? (
                      <>
                        <span class="meta-separator">/</span>
                        <span class="blog-announcer">{post.announcer}</span>
                      </>
                  ) : null}
                </div>

                <h2>{post.title}</h2>

                {post.message ? (
                    <p class="blog-preview" set:html={parseInlineMarkdown(post.message)} />
                ) : null}

              </div>

            </article>
        ))}
      </div>

    </div>
  </main>
</Layout>

<style>
  .blog-page {
    width: 100%;
    max-width: 1120px;
    margin: 4.5rem auto;
    padding: 64px 24px 96px;
    box-sizing: border-box;
  }

  .blog-page h1 {
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .blog-list {
    width: 100%;
    max-width: 900px;
    margin: 120px auto 0;
  }

  .blog-post {
    padding: 28px 0;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
  }

  .blog-post:last-child {
    border-bottom: 1px solid rgba(17, 17, 17, 0.14);
  }

  .blog-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }

  .blog-date {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .blog-post h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 400;
  }

  .blog-announcer {
    margin: 12px 0 8px;
    font-size: 0.9rem;
    font-weight: 400;
    font-style: italic;
    opacity: 0.7;
  }

  .blog-preview {
    max-width: 760px;
    margin: 0;
    line-height: 1.7;
    font-weight: 400;
    opacity: 0.8;
  }

  :global(.blog-preview a) {
    position: relative;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(17, 17, 17, 0.28);
    text-underline-offset: 3px;
    transition: opacity 0.2s ease, text-decoration-color 0.2s ease;
  }

  :global(.blog-preview a)::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  :global(.blog-preview a):hover {
    opacity: 0.65;
    text-decoration-color: transparent;
  }

  :global(.blog-preview a):hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 640px) {
    .blog-page {
      margin: 2rem auto;
      padding: 32px 16px 64px;
    }

    .blog-page h1 {
      font-size: 1.25rem;
      text-align: center;
      white-space: nowrap;
    }

    .blog-list {
      margin-top: 100px;
    }

    .blog-post {
      padding: 24px 0;
    }

    .blog-header {
      gap: 8px;
    }

    .blog-post h2 {
      width: 100%;
      font-size: 1.25rem;
    }

    .blog-announcer {
      margin-top: 10px;
    }

    .blog-preview {
      line-height: 1.65;
    }
  }
</style>