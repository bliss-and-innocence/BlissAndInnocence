---
import Layout from '../../layouts/Layout.astro';
import { activeSubmissions, archivedSubmissions } from '../../data/submissions';
---

<Layout title="Submissions — Bliss & Innocence" description="Open and past album submission calls for Bliss & Innocence.">
  <main class="submissions-page">
    <div class="submissions-content">

      <h1>
        <span class="title-decoration">//// </span>
        Submissions
        <span class="title-decoration"> ////</span>
      </h1>

      <div class="submissions-list">

        {activeSubmissions.length > 0 ? (
          activeSubmissions.map((sub) => (
            <article class="submission-entry">
              <div class="entry-meta">
                {sub.deadline ? (
                  <span class="entry-date">{sub.deadline}</span>
                ) : null}
                <span class="entry-status">Open</span>
              </div>

              <h2>{sub.name}</h2>

              {sub.description ? (
                <p class="entry-description">{sub.description}</p>
              ) : null}

              <div class="entry-footer">
                {sub.submissionLink ? (
                  <a
                    href={sub.submissionLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="submit-link"
                  >
                    Submit ↗
                  </a>
                ) : (
                  <span class="link-tba">Submission link TBA</span>
                )}
              </div>
            </article>
          ))
        ) : (
          <p class="no-active">No submissions are currently open. Check back soon!</p>
        )}

        {archivedSubmissions.length > 0 ? (
          <details class="archive-details">
            <summary class="archive-summary">
              <span class="summary-arrow">▸</span>
              Archive
              <span class="archive-count">({archivedSubmissions.length})</span>
            </summary>

            <ul class="archive-list">
              {archivedSubmissions.map((sub) => (
                <li class="archive-item">
                  <span class="archive-name">{sub.name}</span>
                  {sub.deadline ? (
                    <span class="archive-date">Closed {sub.deadline}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          </details>
        ) : null}

      </div>
    </div>
  </main>
</Layout>

<style>
  .submissions-page {
    width: 100%;
    max-width: 1120px;
    margin: 4.5rem auto;
    padding: 64px 24px 96px;
    box-sizing: border-box;
  }

  .submissions-content {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .submissions-page h1 {
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    font-size: 1.5rem;
    font-weight: lighter;
  }

  /* --------------------------------
     Entry list
  -------------------------------- */

  .submissions-list {
    width: 100%;
    max-width: 900px;
    margin: 120px auto 0;
  }

  .submission-entry {
    padding: 28px 0;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
  }

  .submission-entry:last-of-type {
    border-bottom: 1px solid rgba(17, 17, 17, 0.14);
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .entry-date {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .entry-status {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .entry-meta .entry-date + .entry-status::before {
    content: '/';
    margin-right: 10px;
    opacity: 0.5;
  }

  .submission-entry h2 {
    margin: 0 0 14px;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 400;
  }

  .entry-description {
    max-width: 760px;
    margin: 0 0 20px;
    line-height: 1.8;
    font-weight: 400;
    opacity: 0.8;
    white-space: pre-line;
  }

  .entry-footer {
    margin-top: 4px;
  }

  .submit-link {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 0.2s ease;
  }

  .submit-link:hover {
    opacity: 0.55;
  }

  .link-tba {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
    font-style: italic;
  }

  .no-active {
    padding: 28px 0;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
    border-bottom: 1px solid rgba(17, 17, 17, 0.14);
    font-style: italic;
    opacity: 0.6;
    margin: 0;
  }

  /* --------------------------------
     Archive
  -------------------------------- */

  .archive-details {
    margin-top: 52px;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
    padding-top: 24px;
  }

  .archive-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.5;
    user-select: none;
  }

  .archive-summary::-webkit-details-marker {
    display: none;
  }

  .summary-arrow {
    display: inline-block;
    font-size: 0.6rem;
    transition: transform 0.2s ease;
  }

  .archive-details[open] .summary-arrow {
    transform: rotate(90deg);
  }

  .archive-count {
    opacity: 0.7;
  }

  .archive-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
  }

  .archive-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(17, 17, 17, 0.07);
  }

  .archive-name {
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.75;
  }

  .archive-date {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
    white-space: nowrap;
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 640px) {
    .submissions-page {
      margin: 2rem auto;
      padding: 32px 16px 64px;
    }

    .submissions-page h1 {
      font-size: 1.25rem;
      white-space: nowrap;
    }

    .submissions-list {
      margin-top: 100px;
    }

    .submission-entry {
      padding: 24px 0;
    }

    .archive-item {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
