---
import Layout from '../layouts/Layout.astro';
import { releases } from '../data/releases';
---

<Layout>
  <main class="releases-page">
    <div class="releases-content">
      <h1>
        <span class="title-decoration">//// </span>
        Bliss and Innocence Discography
        <span class="title-decoration"> ////</span>
      </h1>

      <div class="release-grid">
        {releases.map((release) => (
            <a class="release-card" href={`/releases/${release.slug}`}>
              <div class="card-image-wrap">
                <img
                    class="release-cover"
                    src={`/releases/${release.slug}/cover.jpg`}
                    alt={`${release.title} cover artwork`}
                />
              </div>
            </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .releases-page {
    width: 100%;
    max-width: 1200px;
    margin: 4.5rem auto;
    padding: 64px 24px 96px;
    box-sizing: border-box;
  }


  .releases-content {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .releases-page h1 {
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    font-size: 1.5rem;
    font-weight: lighter;
  }


  .release-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 360px));
    gap: 20px;
    align-items: start;
    justify-content: center;
    margin-top: 120px;
  }

  .release-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 360px;
    height: 360px;
    color: inherit;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .release-card:hover {
    transform: translateY(-2px);
    border-color: rgba(17, 17, 17, 0.2);
  }

  .card-image-wrap {
    flex: 1;
    background: rgba(17, 17, 17, 0.08);
  }

  .release-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: rgba(17, 17, 17, 0.08);
  }

  @media (max-width: 640px) {
    .releases-page {
      margin: 2rem auto;
      padding: 32px 16px 64px;
    }

    .title-decoration {
      display: none;
    }

    .releases-content {
      width: 100%;
    }

    .releases-page h1 {
      width: 100%;
      font-size: 1.25rem;
      text-align: center;
      white-space: nowrap;
    }

    .release-grid {
      grid-template-columns: minmax(0, 360px);
      justify-content: center;
      margin-top: 100px;
    }

    .release-card {
      width: 100%;
      max-width: 360px;
    }
  }
</style>
