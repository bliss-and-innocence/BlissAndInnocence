---
import Layout from '../../layouts/Layout.astro';
import { people } from '../../data/people';
import { releases } from '../../data/releases';

const slugify = (value: string) =>
  value
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'person';

const resolvePersonByName = (name?: string) => {
  if (!name || !name.trim()) {
    return null;
  }

  const target = name.trim();
  return people.find((person) => {
    const normalizedPersonName = person.name.trim();
    return (
      person.slug === target ||
      person.slug === slugify(target) ||
      normalizedPersonName.toLowerCase() === target.toLowerCase() ||
      slugify(normalizedPersonName) === slugify(target)
    );
  }) ?? null;
};

const getPersonLink = (name?: string) => {
  const person = resolvePersonByName(name);

  if (!name || !name.trim()) {
    return { href: null, label: 'Unknown' };
  }

  if (person) {
    return { href: `/team/${person.slug}`, label: person.name };
  }

  return { href: null, label: name.trim() };
};

const getTrackUrl = (track: { links?: Array<{ url?: string }> } | undefined) => {
  const url = track?.links?.find((link) => typeof link.url === 'string' && link.url.trim().length > 0)?.url;
  return typeof url === 'string' ? url : null;
};

export function getStaticPaths() {
  return releases.map((release) => ({
    params: { slug: release.slug },
  }));
}

const { slug } = Astro.params;
const release = releases.find((entry) => entry.slug === slug);

if (!release) {
  throw new Error(`Release not found for slug: ${slug}`);
}
---

<Layout>
  <main class="release-page">
    <a href="/" class="back-link">Back to releases</a>
    <h1>{release.title}</h1>

    {release.releaseDate ? <p>{release.releaseDate}</p> : null}
    {release.catalogNumber ? <p>{release.catalogNumber}</p> : null}
    {release.description ? <p>{release.description}</p> : null}

    {release.credits && release.credits.length > 0 ? (
      <section class="section-block misc-credits">
        {release.credits.map((credit) => {
          const personRef = getPersonLink(credit.name);

          return (
            <p class="credit-line">
              {credit.role ? `${credit.role.toLowerCase()} by:` : 'Credit:'}{' '}
              {personRef.href ? (
                <a href={personRef.href} class="person-link">{personRef.label}</a>
              ) : (
                <span>{personRef.label}</span>
              )}
            </p>
          );
        })}
      </section>
    ) : null}

    {release.tracks && release.tracks.length > 0 ? (
      <div class="media-layout">
        <section class="section-block track-panel">
          <h2>Tracks</h2>
          <ul class="track-list">
            {release.tracks.map((track) => {
              const trackUrl = getTrackUrl(track);
              const artistNames = Array.isArray(track.artists) ? track.artists : [];

              return (
                <li>
                  {trackUrl ? (
                    <a href={trackUrl} target="_blank" rel="noreferrer" class="track-link">
                      <strong>{track.title}</strong>
                    </a>
                  ) : (
                    <strong>{track.title}</strong>
                  )}
                  {track.duration ? ` — ${track.duration}` : ''}
                  <div class="track-credit">
                    Artist{artistNames.length > 1 ? 's' : ''}: {' '}
                    {artistNames.length > 0 ? (
                      artistNames.map((artistName, index) => {
                        const personRef = getPersonLink(artistName);

                        return (
                          <>
                            {personRef.href ? (
                              <a href={personRef.href} class="person-link">{personRef.label}</a>
                            ) : (
                              <span>{personRef.label}</span>
                            )}
                            {index < artistNames.length - 1 ? ', ' : ''}
                          </>
                        );
                      })
                    ) : (
                      <span>Unknown</span>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>

        <div class="cover-panel">
          <div class="cover-image-container">
            <img
              src={`/releases/${release.slug}/cover.jpg`}
              alt={`${release.title} cover artwork`}
              class="release-cover"
              data-cover-url={`/releases/${release.slug}/cover.jpg`}
            />
            <div class="cover-overlay">
              View cover art
            </div>
          </div>
        </div>
      </div>
      ) : null}

      <div id="cover-modal" class="cover-modal" aria-hidden="true">
        <div class="cover-modal-backdrop" data-close-cover-modal="true"></div>
        <div class="cover-modal-content">
          <img src={`/releases/${release.slug}/cover.jpg`} alt={`${release.title} cover artwork preview`} class="cover-modal-image" />
        </div>
      </div>
  </main>
</Layout>

<script>
  const coverContainers = document.querySelectorAll('.cover-image-container');
  const coverModal = document.getElementById('cover-modal');

  const hideCoverModal = () => {
      if (!coverModal) return;
      coverModal.classList.remove('is-visible');
      coverModal.setAttribute('aria-hidden', 'true');
  };

  coverContainers.forEach((container) => {
      container.addEventListener('click', () => {
      if (!coverModal) return;
        coverModal.classList.add('is-visible');
        coverModal.setAttribute('aria-hidden', 'false');
      });
  });

  if (coverModal) {
      coverModal.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof HTMLElement && (target === coverModal || target.dataset.closeCoverModal === 'true')) {
          hideCoverModal();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !coverModal.classList.contains('is-visible')) return;
        if (event.key === 'Escape') hideCoverModal();
      });
  }
</script>

<style>
  .release-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 16px;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }

  .section-block {
    margin-top: 28px;
  }

  .media-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 330px);
    gap: 36px;
    align-items: start;
    margin-top: 28px;
  }

  .track-panel {
    margin-top: 0;
    order: 1;
  }

  .cover-panel {
    width: 100%;
    order: 2;
    display: flex;
    flex-direction: column;
  }

  .cover-image-container {
    position: relative;
    width: 100%;
    cursor: pointer;
  }

  .release-cover {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: rgba(17, 17, 17, 0.08);
    border: 1px solid rgba(17, 17, 17, 0.08);
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.26);
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .cover-image-container:hover .cover-overlay {
    opacity: 1;
  }

  .cover-modal {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 2000;
  }

  .cover-modal.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cover-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
  }

  .cover-modal-content {
    position: relative;
    z-index: 1;
    width: min(90vw, 660px);
    background: #ffffff;
    padding: 14px;
    border: 1px solid rgba(17, 17, 17, 0.12);
    cursor: zoom-out;
  }

  .cover-modal-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    background: rgba(17, 17, 17, 0.04);
  }

  .track-list {
    padding-left: 1.2rem;
    margin: 12px 0 0;
  }

  .track-list li {
    margin-bottom: 8px;
  }

  .track-link,
  .person-link {
    color: inherit;
  }

  @media (max-width: 700px) {
    .media-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
