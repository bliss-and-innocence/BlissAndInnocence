---
import Layout from '../layouts/Layout.astro';
import { people, type PersonLink } from '../data/people';

const categoryOrder = [
  'Founder',
  'Cover Artist',
  'Mastering Engineer',
  'XFade Audio Engineer',
  'XFade Video Editor',
  'Graphic Designer',
  'Mathematician',
  'Music Artist',
  'Website Developer',
];

const members = people.filter((person) => person.status === 'core');
const getMemberImageSrc = (member: { [x: string]: unknown; name?: string; roles?: string[] | undefined; status?: string | undefined; links?: PersonLink[] | undefined; slug: any; }) => `/people/pfp/${member.slug}.webp`;

const categories = Array.from(
  new Set(members.flatMap((person) => person.roles ?? [])),
).sort((a, b) => {
  const aIndex = categoryOrder.indexOf(a);
  const bIndex = categoryOrder.indexOf(b);

  if (aIndex !== -1 && bIndex !== -1) {
    return aIndex - bIndex;
  }

  if (aIndex !== -1) {
    return -1;
  }

  if (bIndex !== -1) {
    return 1;
  }

  return a.localeCompare(b);
});
---

<Layout>
  <main class="team-page">
    <div class="team-content">
      <h1>
        <span class="title-decoration">//// </span>
        Core Members
        <span class="title-decoration"> ////</span>
      </h1>

      {categories.map((category) => {
        const categoryMembers = members.filter((person) => (person.roles ?? []).includes(category));

        return (
            <section class="team-category">
              <h2>{category}</h2>
              <div class="member-grid">
                {categoryMembers.map((member) => (
                    <a class="member-card" href={`/team/${member.slug}`}>
                      <div class="card-image" aria-label={`${member.name} profile picture`}>
                        <img
                            src={getMemberImageSrc(member)}
                            alt={`${member.name} profile picture`}
                        />
                      </div>
                      <div class="card-text">
                        <span>{member.name}</span>
                      </div>
                    </a>
                ))}
              </div>
            </section>
        );
      })}
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const images = document.querySelectorAll<HTMLImageElement>('.member-card img');

    images.forEach((img) => {
      img.addEventListener('error', () => {
        img.style.display = 'none';
      });
    });
  });
</script>

<style>
  .team-page {
    width: 100%;
    max-width: 1200px;
    margin: 4.5rem auto;
    padding: 64px 24px 96px;
    box-sizing: border-box;
  }

  .team-content {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Page title */
  .team-page h1 {
    width: 100%;
    margin: 0 0 150px;
    padding: 0;
    text-align: center;
    font-size: 1.5rem;
    font-weight: lighter;
  }

  /* Category */
  .team-category {
    margin: 0 0 64px;
  }

  .team-category h2 {
    margin: 0 0 24px;
    text-align: center;
    font-size: 1rem;
    font-weight: 300;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Members */
  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, 180px);
    gap: 24px 20px;
    justify-content: center;
    align-items: start;
  }

  .member-card {
    display: flex;
    flex-direction: column;
    width: 180px;
    color: inherit;
    text-decoration: none;
    background: transparent;
    border: none;
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .member-card:hover {
    transform: translateY(-2px);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 1;
    background: rgba(17, 17, 17, 0.08);
    overflow: hidden;
  }

  .card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: rgba(17, 17, 17, 0.08);
  }

  .card-text {
    padding: 8px 4px 10px;
    font-size: 0.9rem;
    font-weight: 300;
    font-style: italic;
    text-align: center;
    background: transparent;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .team-page {
      margin: 2rem auto;
      padding: 32px 16px 64px;
    }

    .team-content {
      width: 100%;
    }

    .title-decoration {
      display: none;
    }

    .team-page h1 {
      width: 100%;
      margin: 0 0 100px;
      font-size: 1.25rem;
      text-align: center;
      white-space: nowrap;
    }

    .team-category {
      margin-bottom: 52px;
    }

    .team-category h2 {
      margin-bottom: 20px;
      font-size: 0.9rem;
    }

    .member-grid {
      grid-template-columns: repeat(2, minmax(0, 160px));
      gap: 20px 12px;
      max-width: 340px;
      margin: 0 auto;
    }

    .member-card {
      width: 160px;
    }
  }
</style>
