---
import Layout from '../layouts/Layout.astro';
import { releases } from '../data/releases';
---

<Layout>
  <main class="releases-page">
    <h1>Bliss &amp; Innocence Discography</h1>

    <div class="release-grid">
      {releases.map((release) => (
        <a class="release-card" href={`/releases/${release.slug}`}>
          <div class="card-image-wrap">
            <img
              class="release-cover"
              src={`/releases/${release.slug}/cover.jpg`}
              alt={`${release.title} cover artwork`}
            />
          </div>
          <div class="card-text">
            <span>{release.title}</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .releases-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  .releases-page h1 {
    margin: 0 0 32px;
    font-size: 2.5rem;
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, 360px);
    gap: 20px;
    align-items: start;
  }

  .release-card {
    display: flex;
    flex-direction: column;
    width: 360px;
    height: 360px;
    color: inherit;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .release-card:hover {
    transform: translateY(-2px);
    border-color: rgba(17, 17, 17, 0.2);
  }

  .card-image-wrap {
    flex: 1;
    background: rgba(17, 17, 17, 0.08);
  }

  .release-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: rgba(17, 17, 17, 0.08);
  }

  .card-text {
    padding: 14px 16px;
    font-weight: 600;
    min-height: 56px;
    display: flex;
    align-items: center;
  }
</style>
